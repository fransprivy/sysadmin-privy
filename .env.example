# Admin Center Dashboard - Environment Variables

# Asset URLs (if using external CDN)
NEXT_PUBLIC_ADMIN_LOGO_URL=https://your-cdn.com/assets/logo.png
NEXT_PUBLIC_ADMIN_PROFILE_URL=https://your-cdn.com/assets/profile.png

# API Endpoints (if different from local)
NEXT_PUBLIC_API_URL=https://api.example.com
API_SECRET_KEY=your-secret-key-here

# Database (if using direct queries)
DATABASE_URL=postgresql://user:password@localhost:5432/admin_db

# Feature Flags
ENABLE_ACTIVITY_SYNC=true
ENABLE_REAL_TIME_STATS=false
